{
  "name": "sites-by-fern",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*"]},
  "vars": {"OWNER_EMAIL":"sitesbyfern@outlook.com","SENDER_EMAIL":"sitesbyfern@outlook.com"},
  "d1_databases": [{"binding":"DB","database_name":"sites-by-fern","database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID"}]
}
