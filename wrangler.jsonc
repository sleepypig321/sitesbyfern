{
  "name": "sitesbyfern",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "OWNER_EMAIL": "sitesbyfern@outlook.com",
    "EMAILJS_SERVICE_ID": "sitesbyfern@outlook.com",
    "EMAILJS_INQUIRY_TEMPLATE_ID": "template_f24q3gm",
    "EMAILJS_DECISION_TEMPLATE_ID": "template_kik3zps",
    "STRIPE_TEST_HANDOVER_LINK": "https://buy.stripe.com/test_bJecN451bgJs4Nh21KcAo00",
    "STRIPE_TEST_MAINTAIN_LINK": "https://buy.stripe.com/test_6oU9ASbpzgJs5RldKscAo01",
    "BILLING_DRAFTS_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sites-by-fern",
      "database_id": "e1140026-31c2-4a30-a8ad-018d7db1706a"
    }
  ],
  "triggers": {
    "crons": [
      "15 6 * * *"
    ]
  }
}
