{
  "name": "sitesbyfern",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "OWNER_EMAIL": "sitesbyfern@outlook.com",
    "SENDER_EMAIL": "sitesbyfern@outlook.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sites-by-fern",
      "database_id": "e1140026-31c2-4a30-a8ad-018d7db1706a"
    }
  ]
}
